#include <stdio.h>
#include <string.h>

#define MAX 100

struct Contato
 {
    char nome[50];
    char telefone[20];
};

int main() 
{
    struct Contato agenda[MAX];
    int total = 0;
    int opcao;

    do {
        printf("\n=== Mini Agenda ===\n");
        printf("1 - Adicionar contato\n");
        printf("2 - Listar contatos\n");
        printf("3 - Sair\n");
        printf("Opção: ");
        scanf("%d", &opcao);
        getchar(); 

        switch(opcao) 
        {
            case 1:
                if (total < MAX) 
                {
                    printf("Digite o nome: ");
                    fgets(agenda[total].nome, 50, stdin);
                    agenda[total].nome[strcspn(agenda[total].nome, "\n")] = 0; 
                    printf("Digite o telefone: ");
                    fgets(agenda[total].telefone, 20, stdin);
                    agenda[total].telefone[strcspn(agenda[total].telefone, "\n")] = 0;

                    total++;
                    printf("Contato adicionado!\n");
                } 
                else 
                {
                    printf("Agenda cheia!\n");
                }
                break;
            case 2:
                printf("\n--- Lista de Contatos ---\n");
                for (int i = 0; i < total; i++)
                {
                    printf("%d. %s - %s\n", i+1, agenda[i].nome, agenda[i].telefone);
                }
                if (total == 0)
                {
                    printf("Nenhum contato cadastrado.\n");
                }
                break;
            case 3:
                printf("Saindo.\n");
                break;
            default:
                printf("Opção inválida!\n");
        }
    } while(opcao != 3);

    return 0;
}
